<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.MangaDl" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>

    <style name="Theme.MangaDl.SplashScreen" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#0A0A0F</item>
        <item name="postSplashScreenTheme">@style/Theme.MangaDl</item>
    </style>
</resources>
